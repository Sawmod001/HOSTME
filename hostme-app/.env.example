# ===================== DATABASE =====================
# Supabase PostgreSQL direct connection (via pg pool)
DATABASE_URL=postgresql://postgres.keevicrtyesijgkrtrsb:YOUR_PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# ===================== STORAGE (Supabase) =====================
# For image uploads. SUPABASE_URL is auto-derived from DATABASE_URL if not set.
# Get SERVICE_ROLE_KEY from Supabase Dashboard -> Settings -> API -> service_role key (NOT anon key)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ===================== AUTH (Clerk) =====================
# Used server-side to verify sessions and manage users. Get from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===================== ADMIN BOOTSTRAP =====================
# One-time secret for creating the FIRST admin via /api/auth/admin-setup.
# Disabled in production unless this is set. DELETE after the first admin is created.
ADMIN_SETUP_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# ===================== PAYMENTS (Paystack) =====================
# Used to verify webhooks server-side. Get test keys from https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===================== AI (Gemini) =====================
# Used by ChatBot component. Get key from https://aistudio.google.com
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ===================== WHATSAPP (Cloud API, dev/test) =====================
# WhatsApp Business Cloud API. Test setup (no business verification needed):
#   1. developers.facebook.com -> create a Business-type app
#   2. Add the "WhatsApp" product -> you get a free test phone number
#   3. API Setup screen -> Phone number ID + temporary access token
#   4. Add up to 5 recipient numbers (OTP-verified allow-list)
#   5. Configuration -> webhook callback URL = <your-host>/api/whatsapp/webhook
#      with verify token below (same string) and app secret below
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=hostme_wa_test
WHATSAPP_APP_SECRET=
# Public base URL used by the WhatsApp bot to build web links (group booking invites).
# Leave unset in local dev (defaults to http://localhost:3000). REQUIRED set to your
# production URL before going live.
HOSTME_BASE_URL=
# HMAC secret for signed guest-identity cookies (group booking without sign-in).
# REQUIRED in production. Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# In local dev this falls back to a dev-only value.
HOSTME_GUEST_SECRET=

# ===================== CRON JOBS =====================
# Bearer token that guards /api/cron/* so only Vercel Cron may trigger them.
# Set this in Vercel env and in the Cron job's Authorization header.
CRON_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET
