# ===================== DATABASE =====================
# Supabase PostgreSQL direct connection (via pg pool)
DATABASE_URL=postgresql://postgres.keevicrtyesijgkrtrsb:YOUR_PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# ===================== STORAGE (Supabase) =====================
# For image uploads. SUPABASE_URL is auto-derived from DATABASE_URL if not set.
# Get SERVICE_ROLE_KEY from Supabase Dashboard -> Settings -> API -> service_role key (NOT anon key)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===================== AUTH (Clerk) =====================
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/complete-profile

# ===================== PAYMENTS (Paystack) =====================
# Get test keys from https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===================== AI (Gemini) =====================
# Used by ChatBot component. Get key from https://aistudio.google.com
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ===================== FILE UPLOADS (Cloudinary) =====================
# Required for listing image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===================== CACHE / QUEUES (optional) =====================
# Upstash Redis for rate limiting / session cache
UPSTASH_REDIS_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_TOKEN=your_redis_token

# ===================== LEGACY / RESERVED =====================
# JWT secret for password-based auth (currently unused)
JWT_PASS_SECRET=
